{
  "name": "stock_unrelated_mixed_daily_2020_2024",
  "description": "Daily mixed universe intended as a weaker-relation stress test for VAR2.",
  "tags": ["stock", "mixed", "daily", "weak-relation"],
  "environment_type": "stock_returns",
  "tickers_preset": "unrelated_mixed_core",
  "calibration_start": "2020-01-01",
